# FAILBACK - Environment Configuration Example

# Hindsight AI Memory Layer Configuration
# Optional: Set these to connect to a live Hindsight server or managed cloud bank.
# If omitted or left empty, FAILBACK automatically uses its embedded local Hindsight memory bank.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=failback-incidents

# LLM Provider Configuration (Optional)
# If provided, enables live LLM synthesis.
# If omitted, FAILBACK utilizes its built-in deterministic SRE Incident Reasoning Engine.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
